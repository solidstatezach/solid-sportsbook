# Solid Sportsbook — environment
#
# Both values are OPTIONAL. Leave them unset and the app runs in local
# mode: no accounts, bets live in browser state, nothing is saved.
# Set them (from your Supabase project's Settings → API page) to turn on
# accounts, saved bets, and the leaderboard. See "Going live with
# Supabase" in the README.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
